---
extends: default
ignore: |
  .venv/
  .tools/
  .ansible/
  collections/
rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    # GitHub Actions uses `on:` as a key.
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
