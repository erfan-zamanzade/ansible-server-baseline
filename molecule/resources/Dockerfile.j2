# Test image: the stock distribution image plus systemd, so services, timers
# and handlers behave as on a real server. Built by Molecule's docker driver.
FROM {{ item.image }}
ENV container=docker DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus python3 sudo ca-certificates iproute2 \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && systemctl mask systemd-modules-load.service getty.target console-getty.service systemd-firstboot.service
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
