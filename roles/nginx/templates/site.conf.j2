# {{ ansible_managed }}
upstream {{ item.name }}_backend {
    server {{ item.upstream }};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ item.server_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
{% if nginx_http2_directive %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% else %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}
    server_name {{ item.server_name }};

    ssl_certificate     /etc/nginx/tls/{{ item.name }}.crt;
    ssl_certificate_key /etc/nginx/tls/{{ item.name }}.key;

    access_log /var/log/nginx/{{ item.name }}.access.log json_combined;
    error_log  /var/log/nginx/{{ item.name }}.error.log warn;

    client_max_body_size {{ item.client_max_body_size | default('10m') }};

    add_header Strict-Transport-Security "max-age={{ nginx_hsts_max_age }}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

{% for path in item.internal_locations | default([]) %}
    location = {{ path }} {
{% for network in nginx_internal_networks %}
        allow {{ network }};
{% endfor %}
        deny all;
        proxy_pass http://{{ item.name }}_backend;
        include /etc/nginx/snippets/baseline-proxy.conf;
    }

{% endfor %}
    location / {
        limit_req zone=per_ip burst={{ nginx_rate_limit_burst }} nodelay;
        proxy_pass http://{{ item.name }}_backend;
        include /etc/nginx/snippets/baseline-proxy.conf;
    }
}
